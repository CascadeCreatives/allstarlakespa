---
import { address, permanentAddress, relocation, phone } from '../data/location';
import { showBodyTreatments, showSpaPackages } from '../data/services';
---
<footer>
  <div class="c">
    <div class="foot-grid">
      <div class="foot-brand">
        <h3 class="foot-brand-name">All Star Massage &amp; Spa</h3>
        <p class="foot-brand-loc">Bellevue · Washington · Est. 2006</p>
        <p>Bellevue's premier massage and spa. Medical massage, wellness therapies{showBodyTreatments ? ', facials and body treatments' : ' and facials'}. State-licensed. Insurance accepted. Est. 2006.</p>
        <p class="foot-phone"><a href="tel:4254521772">425.452.1772</a></p>
        <p class="foot-addr">{relocation.active && <span class="foot-temp">Temporarily at {address.building}</span>}{address.streetWithSuite}<br>{address.city}, {address.region} {address.postal}</p>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <a href="/services">Medical Massage Bellevue</a>
        <a href="/services">Deep Tissue Massage</a>
        <a href="/services">Hot Stone Massage</a>
        <a href="/services">Facials Bellevue WA</a>
        {showBodyTreatments && <a href="/services">Body Treatments</a>}
        {showSpaPackages && <a href="/services">Spa Packages</a>}
      </div>
      <div class="foot-col">
        <h4>Visit</h4>
        <a href="/specials">Monthly Specials</a>
        <a href="/gift">Gift Certificates</a>
        <a href="/about">About &amp; Our Team</a>
        <a href="/contact">Location &amp; Hours</a>
        <a href="https://www.secure-booker.com/allstarmassage/MakeAppointment/Search.aspx" target="_blank" rel="noopener">Book Now</a>
        <a href="https://allstarlakespa.boomtime.com/lgift" target="_blank" rel="noopener">Instant Gift Card</a>
      </div>
    </div>
    <div class="foot-btm">
      <p>&copy; 2026 All Star Massage and Spa &middot; {relocation.active && <>Temporarily at </>}{address.streetWithSuite} &middot; {address.city}, {address.region} {address.postal} &middot; <a href={`tel:${phone.tel}`}>{phone.display}</a></p>
      <p><a href="/privacy">Privacy Policy</a> &middot; Massage Bellevue WA &middot; Medical Massage &middot; Deep Tissue &middot; Hot Stone &middot; Facials</p>
    </div>
  </div>
</footer>
